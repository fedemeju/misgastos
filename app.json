{
  "expo": {
    "name": "Mis Gastos",
    "slug": "gastosapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gastos",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "android": {
      "package": "com.fedemeju.gastos",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#acc2a4"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app usa tus fotos para leer tickets y facturas.",
          "cameraPermission": "La app usa la cámara para sacar foto de tickets."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-sqlite",
      "expo-asset",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usá tu huella o rostro para proteger tus saldos."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "776d3c70-5af2-413f-8735-9cfdd3a0b703"
      }
    },
    "owner": "fedemejus-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/776d3c70-5af2-413f-8735-9cfdd3a0b703"
    },
    "ios": {}
  }
}
